{
	"extends": [
		"config:best-practices",
		":pinAllExceptPeerDependencies",
		":separateMultipleMajorReleases",
		":combinePatchMinorReleases",
		":prImmediately",
		":prHourlyLimitNone",
		":prConcurrentLimit20",
		":ignoreUnstable",
		":updateNotScheduled",
		":npm",
		":gomod",
		":docker",
		":label(dependencies)",
		":enableVulnerabilityAlertsWithLabel(security)",
		":semanticCommits",
		":automergePr",
		":automergeRequireAllStatusChecks",
		":automergeDigest",
		":automergeLinters",
		":automergeTesters",
		":automergeTypes",
		":automergeStableNonMajor"
	],
	// Use the platform's native auto-merge (GitHub) instead of Renovate merging itself.
	// Explicit even though it is the modern default, so the intent survives preset changes.
	"platformAutomerge": true,
	// Group all non-major updates (incl. docker digest bumps and lock file maintenance)
	// into a single branch per repository. Without this, every pending update PR is
	// rebased and re-tested by CI after each merge to the base branch - with ~14 open
	// update PRs that multiplies runner minutes by the number of pending updates.
	// Major updates stay separate (see :separateMultipleMajorReleases).
	"packageRules": [
		{
			"description": "Group non-major updates into one PR to reduce CI churn",
			"matchUpdateTypes": [
				"minor",
				"patch",
				"digest",
				"pinDigest",
				"lockFileMaintenance"
			],
			"groupName": "non-major dependency updates",
			"groupSlug": "non-major-updates"
		}
	],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"extends": ["schedule:weekly"]
	},
	// This custom manager allows to update arbitrary yaml values. Renovate documentation: https://docs.renovatebot.com/modules/manager/regex/#optional-capture-groups
	// It requires a # renovate: annotation. The registryUrl and versioning parts are optional.
	// Usage in any yaml file:
	// # renovate: datasource=docker depName=org/repo registryUrl=https://registry.example.com versioning=loose
	// my_version: 1.2.3
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/\\.ya?ml$/"
			],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?( versioning=(?<versioning>\\S+))?\\s+\\S+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
			],
			"versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
		}
	]
}
